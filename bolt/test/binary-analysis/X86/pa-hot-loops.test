# RUN:   --profile-ignore-hash --scanners=perf-loops --lite=0 \
# RUN:   --perf-advisor-report=%t/report.json
# RUN: %python %t/check.py %t/report.json
# RUN: llvm-bolt-binary-analysis %t.exe --perfdata=%t/profile.yaml \
# RUN:   --profile-ignore-hash --scanners=perf-loops --lite=0 \
# RUN:   --execution-count-threshold=4000 --perf-advisor-report=%t/cold.json
# RUN: FileCheck %s --check-prefix=COLD < %t/cold.json
# RUN: %python %t/variants.py %t
# RUN: llvm-bolt-binary-analysis %t.exe --perfdata=%t/fractional.yaml \
# RUN:   --profile-ignore-hash --scanners=perf-loops --lite=0 \
# RUN:   --perf-advisor-report=%t/fractional.json
# RUN: FileCheck %s --check-prefix=FRACTIONAL < %t/fractional.json
