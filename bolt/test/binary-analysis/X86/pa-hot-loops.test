# RUN:   --profile-ignore-hash --scanners=perf-loops --lite=0 \
# RUN:   --perf-advisor-report=%t/single.json
# RUN: FileCheck %s --check-prefix=SINGLE < %t/single.json
# RUN: llvm-bolt-binary-analysis %t.exe --perfdata=%t/unknown.yaml \
# RUN:   --profile-ignore-hash --scanners=perf-loops --lite=0 \
# RUN:   --perf-advisor-report=%t/unknown.json
