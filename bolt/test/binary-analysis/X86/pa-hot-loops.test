# RUN:   --profile-ignore-hash --scanners=perf-loops --lite=0 \
# RUN:   --perf-advisor-report=%t/inconsistent.json
# RUN: FileCheck %s --check-prefix=INCONSISTENT < %t/inconsistent.json
# RUN: llvm-bolt-binary-analysis %t.exe --perfdata=%t/basic.fdata \
# RUN:   --scanners=perf-loops --lite=0 --perf-advisor-report=%t/basic.json
